# Token Bot Discord (Wajib diisi - ambil dari Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Client ID / Application ID Bot (Wajib diisi)
CLIENT_ID=your_client_id_here

# Opsional: ID Server Discord (Guild ID)
# Jika diisi, slash commands akan langsung terdaftar di server ini tanpa menunggu propagasi global
GUILD_ID=

# Opsional: Voice Channel ID tujuan awal
# Jika diisi, bot akan otomatis join ke channel ini saat pertama kali dinyalakan tanpa perlu ketik /join
TARGET_CHANNEL_ID=

# Opsi Voice (true/false)
SELF_DEAF=true
SELF_MUTE=true
