# Discord bot token (required; obtain it from the Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Bot client ID / application ID (required for slash command registration)
CLIENT_ID=your_client_id_here

# Optional: Discord server ID (guild ID)
# Set this to register slash commands in one server without global propagation delays.
GUILD_ID=

# Optional: initial voice channel ID
# Set this and GUILD_ID to join on first startup without using /join.
TARGET_CHANNEL_ID=

